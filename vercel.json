{
  "buildCommand": "bash scripts/build-web.sh",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/log/:id",
      "destination": "/log/[id]"
    },
    {
      "source": "/u/:username",
      "destination": "/api/u?username=:username"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "functions": {
    "api/u.js": {
      "includeFiles": "dist/u/**"
    }
  }
}
